{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"resolveJsonModule": true,

		"paths": {
			"@/*": ["./src/*"]
		},

		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noUncheckedIndexedAccess": true,

		"types": ["node"]
	},
	"include": ["src"]
}
